# Patroclo-Local — variables de entorno.
# Copia este archivo a .env y cambia los valores marcados. .env NUNCA se versiona.
#   cp .env.example .env

# --- PostgreSQL + pgvector (docker compose) ---
POSTGRES_USER=patroclo
POSTGRES_PASSWORD=<CAMBIAR-por-una-contrasena-larga>
POSTGRES_DB=patroclo
# Puerto publicado en el host (127.0.0.1). 5435 para no chocar con otros Postgres locales.
PG_PUERTO=5435
# Dónde busca la base el backend cuando corre FUERA de Docker.
# (Dentro de Docker, docker-compose.yml lo cambia a postgres:5432.)
PG_HOST=localhost

# --- Modelo local (Ollama, contenedor `ollama-gpu` ya existente) ---
LLM_PROVIDER=ollama
# Backend fuera de Docker:
OLLAMA_URL=http://localhost:11434
# Backend dentro de Docker (lo usa docker-compose.yml):
OLLAMA_URL_DOCKER=http://host.docker.internal:11434
CHAT_MODEL=qwen3.5:4b
# Cambiar el modelo de embeddings obliga a reindexar (cambia la dimensión del vector).
EMBEDDING_MODEL=bge-m3

# --- Base de conocimiento ---
COLECCION=patroclo_conocimiento
# Rutas para el backend corriendo FUERA de Docker (dentro, docker-compose.yml las cambia).
CONOCIMIENTO_DIR=../conocimiento
SUBIDAS_DIR=subidas
TAMANO_MAXIMO_MB=10

# --- Autenticación ---
# Secreto para firmar los JWT (HS256). Mínimo 32 caracteres. Generar uno con:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRETO=<CAMBIAR-por-un-secreto-aleatorio-de-al-menos-32-caracteres>
# Horas que dura una sesión.
JWT_HORAS=8

# --- API ---
API_PUERTO=8000
# Documentación interactiva (/docs). Poner en false en el despliegue público.
MOSTRAR_DOCS=true
# Único origen al que CORS deja llamar a la API (la URL del frontend).
ORIGEN_FRONTEND=http://localhost:5173
